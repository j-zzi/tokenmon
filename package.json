{
  "name": "tokenmon",
  "version": "0.1.0",
  "description": "Claude Code / Codex 주간 사용량에 따라 진화하는 macOS 데스크탑 펫",
  "keywords": [
    "electron",
    "desktop-pet",
    "claude-code",
    "codex",
    "usage-tracker",
    "macos"
  ],
  "homepage": "https://github.com/Kimsoo0119/tokenmon#readme",
  "bugs": "https://github.com/Kimsoo0119/tokenmon/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kimsoo0119/tokenmon.git"
  },
  "license": "MIT",
  "author": "Kimsoo0119",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir && codesign --force --deep --sign - dist/mac*/tokenmon.app",
    "install:app": "ditto dist/mac*/tokenmon.app /Applications/tokenmon.app",
    "lint": "eslint .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.github.kimsoo0119.tokenmon",
    "productName": "tokenmon",
    "files": [
      "src/**/*",
      "assets/names-ko.json",
      "assets/pokeball.png"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.8.0"
  }
}
